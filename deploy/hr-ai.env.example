# Copy to /etc/hr-ai/hr-ai.env (owner root, chmod 600). Never commit the real file.
ENVIRONMENT=production
DEV_MODE=false

# Frappe. Use the public https URL of the site.
FRAPPE_URL=http://192.168.10.240:8001/
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_AUTH_MODE=user_session
HR_ADMIN_EMPLOYEES=
REGISTRY_PROFILE=/opt/hr-ai/customer_profiles/starkology.yaml
ROLE_CACHE_SECONDS=60

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

POLICY_DIR=policies
POLICY_LANGUAGE=English

# Only if the widget is served from a different host than the one in the Host header
ALLOWED_ORIGINS=

# nginx on this machine sends X-Real-IP, so trust it (otherwise all users share one IP)
TRUST_PROXY=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_FAIL_PER_MINUTE=10

# Logs
LOG_LEVEL=INFO
LOG_FILE=/var/log/hr-ai/app.log
LOG_JSON=true
AUDIT_LOG_FILE=/var/log/hr-ai/audit.jsonl
# Optional GroqCloud fallback. Set both values to enable.
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=
